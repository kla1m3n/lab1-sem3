{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "default",
      "displayName": "Обычная сборка",
      "description": "Debug-сборка без санитайзеров",
      "inherits": "base"
    },
    {
      "name": "asan",
      "displayName": "Сборка с AddressSanitizer",
      "description": "Поиск ошибок работы с памятью",
      "inherits": "base",
      "cacheVariables": {
        "LAB1_SANITIZER": "address"
      }
    },
    {
      "name": "ubsan",
      "displayName": "Сборка с UndefinedBehaviorSanitizer",
      "description": "Поиск неопределённого поведения",
      "inherits": "base",
      "cacheVariables": {
        "LAB1_SANITIZER": "undefined"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "verbosity": "verbose"
      }
    },
    {
      "name": "default",
      "inherits": "base",
      "configurePreset": "default"
    },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1"
      }
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "configurePreset": "ubsan",
      "environment": {
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "default",
      "steps": [
        { "type": "configure", "name": "default" },
        { "type": "build", "name": "default" },
        { "type": "test", "name": "default" }
      ]
    },
    {
      "name": "asan",
      "steps": [
        { "type": "configure", "name": "asan" },
        { "type": "build", "name": "asan" },
        { "type": "test", "name": "asan" }
      ]
    },
    {
      "name": "ubsan",
      "steps": [
        { "type": "configure", "name": "ubsan" },
        { "type": "build", "name": "ubsan" },
        { "type": "test", "name": "ubsan" }
      ]
    }
  ]
}
